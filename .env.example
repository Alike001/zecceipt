# Server-only Zcash Testnet JSON-RPC endpoint.
# Never prefix this variable with NEXT_PUBLIC_.
# Paste the HTTPS endpoint from the QuickNode dashboard into .env.local.
QUICKNODE_ZCASH_RPC_URL=

# Server-only hosted PostgreSQL connection URL.
# Use the provider's pooled URL for serverless deployments.
DATABASE_URL=

# At least 32 characters. Used only to hash private merchant-management tokens.
INVOICE_MANAGEMENT_SECRET=
